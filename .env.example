# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://paddock:paddock@localhost:55432/paddock

# Generation. Provider is swappable at runtime; see src/paddock/config.py.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Judging. Must differ from LLM_PROVIDER — a model grading its own output
# shows self-preference bias.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.6-flash

# Observability (Langfuse Cloud free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Public-demo guards. The limiter paces one caller; the cap bounds total spend.
# API_TRUSTED_PROXY_HOPS is how many reverse proxies stand in front of the API:
# 0 locally, 1 behind Caddy. Above 0 the limiter reads X-Forwarded-For, which is
# caller-supplied, so this number must match the deployment exactly.
API_RATE_LIMIT_PER_MINUTE=10
API_DAILY_LLM_CALL_CAP=500
API_TRUSTED_PROXY_HOPS=0

# Where the Streamlit demo looks for the API. Two processes, so a URL.
UI_API_BASE_URL=http://127.0.0.1:8000

# Alerting for scheduled ingest failures
TELEGRAM_API_TOKEN=
TELEGRAM_CHAT_ID=
